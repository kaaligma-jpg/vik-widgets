async function askFincopToRead(clientId, docTs){
  const c = clients.find(x=>x.id===clientId);
  if(!c) return;
  const doc = (c.documents||[]).find(d=>d.ts===docTs);
  if(!doc) return;
  const flightKey = clientId+'_'+docTs;
  if(docReadInFlight.has(flightKey)) return;
  docReadInFlight.add(flightKey);
  document.getElementById('docsWrap') && (document.getElementById('docsWrap').innerHTML = renderDocuments(c));
  try{
    const mimeMatch = /^data:([^;]+);base64,/.exec(doc.dataUrl||'');
    const mimeType = mimeMatch ? mimeMatch[1] : 'application/octet-stream';
    const res = await fetch('https://fincop-backend.onrender.com/fincop-read-document', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ dealCode: c.dealCode, leadName: c.name, filename: doc.filename, mimeType, documentBase64: doc.dataUrl })
    });
    if(!res.ok) throw new Error('read failed');
    const data = await res.json();
    doc.summary = (data && data.summary) ? data.summary : 'FinCop returned no summary.';
    doc.readStatus = 'read';
  }catch(e){
    doc.summary = 'FinCop could not read this document — try again in a moment.';
    doc.readStatus = 'read failed';
  }
  docReadInFlight.delete(flightKey);
  await saveClients();
  if(document.getElementById('docsWrap')) document.getElementById('docsWrap').innerHTML = renderDocuments(c);
}

