  if(lvlInput && savedLevel && !lvlInput.value) lvlInput.value = savedLevel;

  const tbody = document.getElementById('recruitTbody');
  const rowCards = document.getElementById('recruitRowCards');
  const emptyState = document.getElementById('recruitEmpty');
  const filtered = recruits.filter(matchesRecruitFilters).sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));

  if(!filtered.length){
    tbody.innerHTML = '';
    rowCards.innerHTML = '';
    emptyState.style.display = 'block';
  } else {
    emptyState.style.display = 'none';
    tbody.innerHTML = filtered.map(r=>{
      const pct = attendancePct(r);
      return `
      <tr onclick="openRecruitDetail('${r.id}')">
        <td class="name-cell">${escapeHtml(r.name)||'—'}<div class="meta">${escapeHtml(r.professionCategory)||'—'}</div></td>
