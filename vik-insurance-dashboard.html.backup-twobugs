        <td>${r.coachingLevel||'—'}</td>
        <td>${pct}%</td>
        <td>${recruitLicensingLabel(r)}</td>
        <td>${recruitRiskBadge(r)}</td>
      </tr>`;
    }).join('');

    rowCards.innerHTML = filtered.map(r=>{
      const pct = attendancePct(r);
      return `
      <div class="row-card" onclick="openRecruitDetail('${r.id}')">
        <div class="row1">
          <div>
            <div class="name-cell">${escapeHtml(r.name)||'—'}</div>
            <div class="meta">${escapeHtml(r.professionCategory)||'—'} · ${recruitProgramDayLabel(r)} · ${pct}% attendance</div>
          </div>
          ${recruitRiskBadge(r)}
        </div>
      </div>`;
    }).join('');
  }

  // Keep the open detail modal in sync with any change made elsewhere (e.g. Guru's async reply).
  if(openRecruitId && document.getElementById('overlay').classList.contains('show')){
    const r = recruits.find(x=>x.id===openRecruitId);
    if(r) renderRecruitDetailPanel(r);
    else { openRecruitId = null; closeOverlay(); }
  }
}

