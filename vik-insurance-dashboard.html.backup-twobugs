function wireRecruitDetail(r){
  const panel = document.getElementById('panel');
  const id = r.id;

  panel.querySelectorAll('select[data-exam-idx]').forEach(sel=>{
    sel.addEventListener('change', ()=>{
      const i = Number(sel.getAttribute('data-exam-idx'));
      r.examStages[i].status = sel.value;
      saveRecruits(); renderRecruits();
    });
  });

  panel.querySelectorAll('select[data-rfield]').forEach(sel=>{
    sel.addEventListener('change', ()=>{
      r[sel.getAttribute('data-rfield')] = sel.value;
      saveRecruits(); renderRecruits();
    });
  });

  panel.querySelectorAll('input[data-tfield]').forEach(inp=>{
    inp.addEventListener('change', ()=>{
      const field = inp.getAttribute('data-tfield');
      r[field] = inp.value;
      if(field==='firstName' || field==='lastName'){
        r.name = [r.firstName, r.lastName].filter(Boolean).join(' ');
      }
      saveRecruits(); renderRecruits();
    });
  });

  panel.querySelectorAll('input[data-nfield]').forEach(inp=>{
    inp.addEventListener('change', ()=>{
      r[inp.getAttribute('data-nfield')] = Number(inp.value)||0;
      saveRecruits();
    });
  });

  const addChildBtn = panel.querySelector('[data-add-child]');
  if(addChildBtn) addChildBtn.addEventListener('click', ()=> openAddChildModal(r));
  panel.querySelectorAll('[data-remove-child]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const i = Number(btn.getAttribute('data-remove-child'));
      r.children.splice(i,1);
      saveRecruits(); renderRecruits();
    });
  });

  const addProspectBtn = panel.querySelector('[data-add-prospect]');
  if(addProspectBtn) addProspectBtn.addEventListener('click', ()=> openAddProspectModal(r));
  panel.querySelectorAll('[data-remove-prospect]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const i = Number(btn.getAttribute('data-remove-prospect'));
      r.prospects.splice(i,1);
      saveRecruits(); renderRecruits();
    });
  });
  panel.querySelectorAll('[data-prospect-tier]').forEach(sel=>{
    sel.addEventListener('change', ()=>{
      const i = Number(sel.getAttribute('data-prospect-tier'));
      r.prospects[i].tier = sel.value;
      saveRecruits(); renderRecruits();
    });
  });

  panel.querySelectorAll('input[data-event]').forEach(chk=>{
    chk.addEventListener('change', ()=>{
      r.events[chk.getAttribute('data-event')] = chk.checked;
      saveRecruits();
    });
  });

  const guruBtn = panel.querySelector('[data-guru-suggest-btn]');
  if(guruBtn) guruBtn.addEventListener('click', ()=> askGuruForAdvice(id));

  const openSatBtn = panel.querySelector('[data-open-sat]');
  if(openSatBtn) openSatBtn.addEventListener('click', ()=> openSaturdayModal(id));
}


