// Lightly formats Vikram's research text into structured HTML (headers,
// bullets, bold) instead of a dense run-on paragraph. Mirrors the mortgage
// dashboard's formatter. Escapes first so no raw HTML can leak through.
function formatResearchText(raw){
  const esc = escapeHtml(raw||'');
  const lines = esc.split('\n');
  let html = '';
  let inList = false;
  for(let line of lines){
    const trimmed = line.trim();
    if(!trimmed){ if(inList){ html += '</ul>'; inList = false; } continue; }
    const heading = trimmed.match(/^#{1,4}\s*(.+)/);
    const bullet = trimmed.match(/^[-*]\s+(.+)/);
    if(heading){
      if(inList){ html += '</ul>'; inList = false; }
      html += `<h4 class="research-heading">${heading[1]}</h4>`;
    } else if(bullet){
      if(!inList){ html += '<ul class="research-list">'; inList = true; }
      html += `<li>${bullet[1]}</li>`;
    } else {
      if(inList){ html += '</ul>'; inList = false; }
      html += `<p class="research-para">${trimmed}</p>`;
    }
  }
  if(inList) html += '</ul>';
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  return html;
}

function matchesFilters(c){
