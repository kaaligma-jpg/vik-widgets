// Vikram's auto lead-research, mirrored from the mortgage dashboard. Fires once
// per new lead (and can be re-run manually). Splits the single "name" field
// into firstName/lastName since that's what the backend endpoint expects.
const researchInFlight = new Set();
async function triggerVikramResearch(id){
  const c = clients.find(x=>x.id===id);
  if(!c) return;
  if(researchInFlight.has(id)) return;
  researchInFlight.add(id);
  try{
    const nameParts = (c.name||'').trim().split(/\s+/);
    const firstName = nameParts[0] || '';
    const lastName = nameParts.slice(1).join(' ') || '';
    const res = await fetch('https://fincop-backend.onrender.com/vikram-research', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ firstName, lastName, phone:c.phone, email:c.email })
    });
    if(!res.ok) throw new Error('no research endpoint yet');
    const data = await res.json();
    const summary = (data && data.summary) ? data.summary : 'Research returned no summary.';
    c.researchNotes = c.researchNotes || [];
    c.researchNotes.push({ text: summary, ts: Date.now(), author: 'Vikram' });
    c.researchStatus = 'done';
  }catch(e){
    c.researchNotes = c.researchNotes || [];
    c.researchNotes.push({ text: 'Auto-research pending — Vikram\'s research API isn\'t connected yet. Add findings manually below for now, or tap "Run research" once the backend endpoint is live.', ts: Date.now(), author: 'Vikram' });
    c.researchStatus = 'pending';
  }
  researchInFlight.delete(id);
  await saveClients();
  render();
  if(document.getElementById('overlay').classList.contains('show')){ openDetail(id); switchLayerTab('research'); }
}

// ---- Sasha: per-lead communication agent (mirrored from the mortgage
// dashboard, adapted to this dashboard's flat-card layout instead of a
// tabbed detail modal) ----
async function sendSashaMessage(id, isVoice){
  const c = clients.find(x=>x.id===id);
  if(!c) return;
  const cardInput = document.getElementById('sashaInput');
  if(!cardInput) return;
  const text = cardInput.value.trim();
  if(!text) return;
  if(!Array.isArray(c.sashaChat)) c.sashaChat = [];
  c.sashaChat.push({ from:'Vik', text, ts: Date.now() });
  await saveClients();
  if(document.getElementById('overlay').classList.contains('show')){ openDetail(id); switchLayerTab('sasha'); }
  // Sasha's replies are backend-powered (drafting/sending logic + this
  // lead's research/comm context). Until that endpoint is live, she
  // acknowledges and logs the ask rather than inventing a fake response.
  let replyText;
  try{
    const res = await fetch('https://fincop-backend.onrender.com/sasha-chat', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ dealCode:c.dealCode, name:c.name, email:c.email, phone:c.phone, message:text, autoSend:c.sashaAutoSend, researchNotes:c.researchNotes, history:c.sashaChat })
    });
    if(!res.ok) throw new Error('sasha backend not live yet');
    const data = await res.json();
    replyText = (data && data.reply) || 'Got it.';
    if(data && data.sent) replyText += '\n\n(Sent via ' + (data.channel||'email').toLowerCase() + ' to ' + (data.to || 'the client') + ')';
    else if(data && data.sendError) replyText += '\n\n(Not sent — ' + data.sendError + ')';
    c.sashaChat.push({ from:'Sasha', text: replyText, ts: Date.now() });
  }catch(e){
    replyText = "Noted — I can't draft or send yet since my backend isn't connected. Once Vik wires up my endpoint, I'll reply here and " + (c.sashaAutoSend ? "send this on my own." : "hold it for your approval first.");
    c.sashaChat.push({ from:'Sasha', text: replyText, ts: Date.now() });
  }
  await saveClients();
  if(document.getElementById('overlay').classList.contains('show')){ openDetail(id); switchLayerTab('sasha'); }
  if(isVoice) speakSashaReply(replyText);
}

// ---- Sasha voice: browser speech-to-text (mic) + text-to-speech (reply read aloud) ----
let sashaRecognition = null;
let sashaListeningDealId = null;

function speakSashaReply(text){
  if(!window.speechSynthesis) return;
  window.speechSynthesis.cancel();
  const utter = new SpeechSynthesisUtterance(text);
  utter.rate = 1;
  utter.pitch = 1;
  window.speechSynthesis.speak(utter);
}

function toggleSashaVoice(id){
  const SpeechRecognitionAPI = window.SpeechRecognition || window.webkitSpeechRecognition;
  const btn = document.getElementById('sashaVoiceBtn');
  const hint = document.getElementById('sashaVoiceHint');
  if(!SpeechRecognitionAPI){
    showToast('Voice chat needs Chrome or Edge — this browser doesn\'t support it yet.');
    return;
  }
  if(sashaRecognition && sashaListeningDealId === id){
    sashaRecognition.stop();
    return;
  }
  if(sashaRecognition){ sashaRecognition.stop(); }

  sashaRecognition = new SpeechRecognitionAPI();
  sashaRecognition.lang = 'en-US';
  sashaRecognition.continuous = false;
  sashaRecognition.interimResults = false;
  sashaListeningDealId = id;

  sashaRecognition.onstart = () => {
    if(btn) btn.classList.add('listening');
    if(hint) hint.textContent = 'Listening… speak now.';
  };
  sashaRecognition.onresult = (event) => {
    const transcript = event.results[0][0].transcript;
    const cardInput = document.getElementById('sashaInput');
    if(cardInput) cardInput.value = transcript;
    if(hint) hint.textContent = '';
    sendSashaMessage(id, true);
  };
  sashaRecognition.onerror = (event) => {
    if(hint) hint.textContent = event.error === 'not-allowed'
      ? 'Microphone access was blocked — allow it in the browser to talk to Sasha.'
      : 'Didn\'t catch that — tap the mic and try again.';
  };
  sashaRecognition.onend = () => {
    if(btn) btn.classList.remove('listening');
    sashaRecognition = null;
    sashaListeningDealId = null;
  };
  sashaRecognition.start();
}

