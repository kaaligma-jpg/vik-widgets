function recruitAge(r){
  if(!r.dob) return null;
  const d = new Date(r.dob);
  if(isNaN(d.getTime())) return null;
  const diff = Date.now() - d.getTime();
  return Math.floor(diff / (365.25*86400000));
}

function matchesRecruitFilters(r){
  const q = (document.getElementById('recruitSearch').value||'').trim().toLowerCase();
  const coach = document.getElementById('filterCoachability').value;
  const risk = document.getElementById('filterRisk').value;
  const profession = (document.getElementById('filterProfession').value||'').trim().toLowerCase();
  const ageBand = document.getElementById('filterAgeBandRecruit').value;
  const hobbies = (document.getElementById('filterHobbies').value||'').trim().toLowerCase();
  const marital = document.getElementById('filterMaritalStatus').value;
  const hasKids = document.getElementById('filterHasKids').value;

  if(q && (r.name||'').toLowerCase().indexOf(q)===-1) return false;
  if(coach && r.coachingLevel !== coach) return false;
  if(risk==='At risk' && !isAtRisk(r)) return false;
  if(risk==='On track' && isAtRisk(r)) return false;
  if(profession && (r.professionCategory||'').toLowerCase().indexOf(profession)===-1) return false;
  if(hobbies && (r.hobbies||'').toLowerCase().indexOf(hobbies)===-1) return false;
  if(ageBand){
    const age = recruitAge(r);
    if(age===null) return false;
    const [lo,hi] = ageBand.split('-').map(Number);
    if(age < lo || age > hi) return false;
  }
  if(marital==='married' && (!r.partnerRelation || r.partnerRelation==='None')) return false;
  if(marital==='single' && r.partnerRelation && r.partnerRelation!=='None') return false;
  if(hasKids==='yes' && !(r.children && r.children.length>0)) return false;
  if(hasKids==='no' && (r.children && r.children.length>0)) return false;
  return true;
}

