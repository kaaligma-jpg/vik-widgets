function openSaturdayModal(recruitId){
  const r = recruits.find(x=>x.id===recruitId);
  if(!r) return;
  if(!Array.isArray(r.superSaturdays)) r.superSaturdays = [];
  const startYear = new Date().getFullYear();
  const years = [startYear, startYear+1];
  let html = `<h2>Super Saturday attendance</h2><p class="sub" style="margin-top:0;">Check every Saturday they attended (long weekends count too). The % updates automatically.</p><div class="sat-modal-list">`;
  years.forEach(year=>{
    html += `<div class="sat-year-label">${year}</div>`;
    let d = new Date(year,0,1);
    while(d.getFullYear()===year){
      if(d.getDay()===6){
        const iso = d.toISOString().slice(0,10);
        const checked = r.superSaturdays.includes(iso);
        const label = d.toLocaleDateString('en-CA', { month:'short', day:'numeric', weekday:'short' });
        html += `<label class="sat-row"><input type="checkbox" data-sat-date="${iso}" ${checked?'checked':''}> ${label}, ${year}</label>`;
      }
      d.setDate(d.getDate()+1);
    }
  });
  html += `</div><div class="panel-actions"><button class="btn" id="closeSatModal">Done</button></div>`;
  const panel = document.getElementById('satPanel');
  panel.innerHTML = html;
  panel.querySelectorAll('input[data-sat-date]').forEach(chk=>{
    chk.addEventListener('change', ()=>{
      const date = chk.getAttribute('data-sat-date');
      if(chk.checked){
        if(!r.superSaturdays.includes(date)) r.superSaturdays.push(date);
      } else {
        r.superSaturdays = r.superSaturdays.filter(x=>x!==date);
      }
      saveRecruits();
    });
  });
  document.getElementById('closeSatModal').addEventListener('click', ()=>{
    document.getElementById('satOverlay').classList.remove('show');
    renderRecruits();
  });
  document.getElementById('satOverlay').classList.add('show');
}
