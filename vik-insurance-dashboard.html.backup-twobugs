<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vik — Insurance Pipeline</title>
<style>
  :root{
    --ink:#152238;
    --ink-2:#1F3352;
    --paper:#F6F4EF;
    --paper-2:#FFFFFF;
    --brass:#A9762F;
    --brass-2:#C69350;
    --slate:#5B6472;
    --line:#E2DED4;
    --good:#3C6E47;
    --warn:#B4762E;
    --danger:#A23B34;
    --serif: Georgia, 'Iowan Old Style', 'Palatino Linotype', serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  *{box-sizing:border-box;}
  body{ margin:0; background:var(--paper); color:var(--ink); font-family:var(--sans); -webkit-font-smoothing:antialiased; }
  .app{ display:flex; min-height:100vh; }
  .sidebar{ width:220px; background:var(--ink); color:#EDE8DD; padding:28px 20px; flex-shrink:0; }
  @media (max-width: 820px){
    .app{ flex-direction:column; }
    .sidebar{ width:100%; padding:18px 20px; display:flex; align-items:center; justify-content:space-between; }
    .sidebar .navlist{ display:none; }
  }
  .brand{ font-family:var(--serif); font-size:22px; letter-spacing:0.2px; color:#fff; }
  .brand small{ display:block; font-family:var(--sans); font-size:11px; color:var(--brass-2); margin-top:4px; font-weight:600; }
  .navlist{ margin-top:36px; display:flex; flex-direction:column; gap:4px; }
  .navlist a{ all:unset; cursor:pointer; padding:10px 12px; border-radius:6px; font-size:14px; color:#C9D0DC; display:block; }
  .navlist a.active{ background:rgba(255,255,255,0.08); color:#fff; }
  .navlist a:hover{ background:rgba(255,255,255,0.06); }

  .main{ flex:1; padding:32px 36px 80px; max-width:1180px; }
  @media (max-width: 640px){ .main{ padding:20px 16px 60px; } }

  h1{ font-family:var(--serif); font-size:28px; margin:0 0 4px; font-weight:600; }
  .sub{ color:var(--slate); font-size:14px; margin:0 0 28px; }

  .stats{ display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:28px; }
  .stat{ background:var(--paper-2); border:1px solid var(--line); border-radius:8px; padding:14px 16px; }
  .stat .num{ font-family:var(--serif); font-size:26px; color:var(--ink); }
  .stat .lbl{ font-size:12px; color:var(--slate); margin-top:2px; }

  .toolbar{ display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-bottom:18px; }
  input, select, textarea{ font-family:var(--sans); font-size:14px; border:1px solid var(--line); background:var(--paper-2); border-radius:6px; padding:9px 11px; color:var(--ink); }
  input:focus, select:focus, textarea:focus{ outline:2px solid var(--brass-2); outline-offset:1px; }
  #search{ flex:1; min-width:180px; }
  .btn{ all:unset; cursor:pointer; font-size:14px; font-weight:600; padding:9px 16px; border-radius:6px; background:var(--ink); color:#fff; }
  .btn:hover{ background:var(--ink-2); }
  .btn.ghost{ background:transparent; border:1px solid var(--line); color:var(--ink); }
  .btn.ghost:hover{ background:#FBFAF6; }
  .btn.small{ padding:6px 12px; font-size:12px; }

  .card{ background:var(--paper-2); border:1px solid var(--line); border-radius:10px; padding:16px 18px; margin-bottom:12px; }
  .card .top{ display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap; align-items:flex-start; }
  .card .name{ font-family:var(--serif); font-size:18px; font-weight:600; }
  .card .meta{ font-size:12px; color:var(--slate); margin-top:2px; }
  .badge{ font-size:11px; font-weight:700; padding:3px 9px; border-radius:20px; white-space:nowrap; }
  .badge.insurance{ background:#DCE6EE; color:#2E5B7C; }
  .badge.investment{ background:#F0E1C8; color:var(--warn); }
  .badge.both{ background:#E4DCF5; color:#5B3E9E; }
  .badge.neo{ background:#F5DEDB; color:var(--danger); }
  .badge.nikki{ background:#DCE9DC; color:var(--good); }

  .grid3{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:12px; }
  @media (max-width:700px){ .grid3{ grid-template-columns:1fr; } }
  .field label{ display:block; font-size:11px; color:var(--slate); margin-bottom:4px; font-weight:600; }
  .field select, .field input{ width:100%; }

  .notes{ margin-top:12px; border-top:1px solid var(--line); padding-top:10px; }
  .notes .n{ font-size:13px; padding:6px 0; border-bottom:1px dashed var(--line); }
  .research-heading{ font-size:13px; font-weight:700; margin:8px 0 4px; }
  .research-heading:first-child{ margin-top:0; }
  .research-list{ margin:0 0 6px 18px; padding:0; }
  .research-list li{ margin-bottom:3px; }
  .research-para{ margin:0 0 6px; line-height:1.45; }
  .notes .n:last-child{ border-bottom:none; }
  .notes .n .ts{ font-size:11px; color:var(--slate); margin-left:6px; }
  .sasha-chat{ display:flex; flex-direction:column; gap:8px; max-height:280px; overflow-y:auto; padding:4px 2px; }
  .sasha-msg{ max-width:82%; padding:8px 12px; border-radius:12px; font-size:13px; white-space:pre-wrap; }
  .sasha-msg.vik{ align-self:flex-end; background:var(--brass, #b48c3c); color:#fff; border-bottom-right-radius:3px; }
  .sasha-msg.sasha{ align-self:flex-start; background:#F1EAFB; color:var(--ink, #222); border-bottom-left-radius:3px; }
  .sasha-msg .item-meta{ opacity:0.75; font-size:11px; margin-bottom:2px; }
  .sasha-voice-btn{ font-size:16px; padding:6px 10px; border-radius:50%; background:#F1EAFB; border:1px solid var(--brass, #b48c3c); cursor:pointer; line-height:1; }
  .sasha-voice-btn.listening{ background:var(--brass, #b48c3c); animation:sashaPulse 1s infinite; }
  @keyframes sashaPulse{ 0%{ box-shadow:0 0 0 0 rgba(180,140,60,0.5); } 70%{ box-shadow:0 0 0 10px rgba(180,140,60,0); } 100%{ box-shadow:0 0 0 0 rgba(180,140,60,0); } }
  .sasha-voice-hint{ font-size:11px; opacity:0.7; margin-top:4px; }
  .addnote{ display:flex; gap:8px; margin-top:8px; }
  .addnote textarea{ flex:1; min-height:36px; resize:vertical; }

  .empty{ text-align:center; padding:60px 20px; color:var(--slate); }

  .toast{ position:fixed; bottom:20px; left:50%; transform:translateX(-50%) translateY(20px); background:var(--ink); color:#fff; padding:10px 18px; border-radius:8px; font-size:13px; opacity:0; pointer-events:none; transition:all .25s; }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }

  .rcard{ background:var(--paper-2); border:1px solid var(--line); border-radius:10px; padding:16px 18px; margin-bottom:14px; }
  .rtop{ display:flex; justify-content:space-between; align-items:flex-start; gap:10px; flex-wrap:wrap; margin-bottom:8px; }
  .rname{ font-family:var(--serif); font-size:18px; }
  .rmeta{ font-size:12px; color:var(--slate); margin-top:2px; }
  .risk-badge{ font-size:11px; font-weight:700; padding:4px 10px; border-radius:999px; }
  .risk-badge.ok{ background:#E4EFE6; color:var(--good); }
  .risk-badge.flag{ background:#F6E4DF; color:var(--danger); }
  .rgrid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin-top:14px; }
  .rfield label{ display:block; font-size:11px; color:var(--slate); margin-bottom:4px; text-transform:uppercase; letter-spacing:.3px; }
  .exam-list{ display:flex; flex-direction:column; gap:6px; margin-top:6px; }
  .exam-row{ display:flex; align-items:center; justify-content:space-between; font-size:13px; background:var(--paper); border:1px solid var(--line); border-radius:6px; padding:6px 10px; }
  .exam-row select{ padding:4px 8px; font-size:12px; }
  .events-row{ display:flex; gap:14px; flex-wrap:wrap; margin-top:8px; }
  .events-row label{ font-size:13px; display:flex; align-items:center; gap:6px; }
  .satpct{ font-family:var(--serif); font-size:20px; }
  .rsection-title{ font-size:12px; color:var(--slate); text-transform:uppercase; letter-spacing:.4px; margin:14px 0 4px; font-weight:700; }

  /* ---- Pipeline table + detail modal (mirrors the mortgage dashboard's layout) ---- */
  table{ width:100%; border-collapse:collapse; background:var(--paper-2); border:1px solid var(--line); border-radius:8px; overflow:hidden; }
  thead th{ text-align:left; font-size:12px; color:var(--slate); font-weight:600; padding:10px 12px; border-bottom:1px solid var(--line); background:#FBFAF6; }
  tbody td{ padding:12px; border-bottom:1px solid var(--line); font-size:14px; vertical-align:top; }
  tbody tr:last-child td{ border-bottom:none; }
  tbody tr:hover{ background:#FBFAF6; cursor:pointer; }
  .name-cell{ font-weight:600; }
  .name-cell .meta{ font-weight:400; color:var(--slate); font-size:12px; margin-top:2px; }
  .code-tag{ font-size:11px; color:var(--brass); font-weight:600; }

  .row-cards{ display:none; }
  @media (max-width: 720px){
    table{ display:none; }
    .row-cards{ display:flex; flex-direction:column; gap:10px; }
    .row-card{ background:var(--paper-2); border:1px solid var(--line); border-radius:8px; padding:14px; cursor:pointer; }
    .row-card .row1{ display:flex; justify-content:space-between; align-items:start; gap:8px; }
  }

  .overlay{ position:fixed; inset:0; background:rgba(21,34,56,0.45); display:none; align-items:flex-start; justify-content:center; padding:40px 16px; overflow-y:auto; z-index:50; }
  .overlay.show{ display:flex; }
  .panel{ background:var(--paper-2); border-radius:10px; width:100%; max-width:640px; padding:28px; margin-bottom:40px; }
  .panel h2{ font-family:var(--serif); font-size:20px; margin:0 0 4px; }
  .panel-actions{ display:flex; justify-content:flex-end; gap:8px; margin-top:22px; }

  .drawer-overlay{ position:fixed; inset:0; background:rgba(21,34,56,0.35); display:none; z-index:55; }
  .drawer-overlay.show{ display:block; }
  .drawer{ position:fixed; top:0; right:0; height:100%; width:320px; max-width:90vw; background:var(--paper-2); box-shadow:-6px 0 24px rgba(21,34,56,0.18); padding:22px; overflow-y:auto; }
  .drawer h2{ font-family:var(--serif); font-size:18px; margin:0 0 16px; }
  .drawer .rfield{ margin-bottom:14px; }
  .drawer .rfield label{ display:block; font-size:12px; color:var(--slate); margin-bottom:4px; }
  .drawer .rfield input, .drawer .rfield select{ width:100%; }

  .detail dt{ font-size:12px; color:var(--slate); margin-top:12px; }
  .detail dd{ margin:2px 0 0; font-size:15px; }
  .detail .sechead{ font-size:12px; text-transform:uppercase; letter-spacing:0.5px; color:var(--brass); font-weight:700; margin:20px 0 4px; border-top:1px solid var(--line); padding-top:14px; }
  .detail .sechead:first-of-type{ border-top:none; padding-top:0; margin-top:14px; }

  .call-icon-btn{ all:unset; cursor:pointer; width:30px; height:30px; border-radius:50%; background:#EAF4EC; color:#2E7D32; display:inline-flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; text-decoration:none; }
  .call-icon-btn:hover{ background:#D7EBDA; }

  /* ---- Notes & history layers (mirrors the mortgage dashboard's detail panel) ---- */
  .top-summary-box{ background:#FFF8E6; border:1px solid #E8D9A6; border-radius:8px; padding:10px 12px; margin-top:6px; }
  .top-summary-box textarea{ width:100%; border:none; background:transparent; resize:vertical; font-size:13px; font-family:inherit; }
  .layer-tabs{ display:flex; gap:6px; margin-top:8px; flex-wrap:wrap; }
  .layer-tab{ all:unset; cursor:pointer; font-size:12px; font-weight:600; padding:6px 12px; border-radius:16px; background:#F1EFE8; color:var(--slate); }
  .layer-tab.active{ background:var(--brass); color:#fff; }
  .layer-pane{ display:none; margin-top:10px; }
  .layer-pane.active{ display:block; }
  .note-item{ background:#FBFAF6; border:1px solid var(--line); border-radius:6px; padding:8px 10px; margin-bottom:8px; }
  .note-empty{ font-size:13px; color:var(--slate); }
  .comm-item{ background:#F5F8FC; border:1px solid #DCE6F2; border-radius:6px; padding:8px 10px; margin-bottom:8px; }
  .agent-item{ background:#F8F5FC; border:1px solid #E5DCF2; border-radius:6px; padding:8px 10px; margin-bottom:8px; }
  .research-item{ background:#F5FCF7; border:1px solid #D9EFE0; border-radius:6px; padding:8px 10px; margin-bottom:8px; }
  .item-meta{ font-size:11px; color:var(--slate); margin-bottom:3px; }
  .item-text{ font-size:13px; color:var(--ink); white-space:pre-wrap; }
  .doc-item{ display:flex; }
  .sat-year-label{ font-family:var(--serif); font-size:15px; font-weight:600; margin:16px 0 8px; }
  .sat-year-label:first-child{ margin-top:0; }
  .sat-modal-list{ max-height:50vh; overflow-y:auto; padding-right:4px; }
  .sat-row{ display:flex; align-items:center; gap:8px; padding:5px 2px; font-size:13px; }
  .sat-row input{ width:auto; }
</style>
</head>
<body>
<div class="app">
  <div class="sidebar">
    <div class="brand">Vik<small>INSURANCE PIPELINE</small></div>
    <div class="navlist">
      <a class="active" id="navPipeline" onclick="showView('pipeline')">Pipeline</a>
      <a href="vik-mortgage-dashboard.html">Mortgage Pipeline</a>
      <a id="navRecruits" onclick="showView('recruits')">Recruits (Guru)</a>
    </div>
  </div>

  <div class="main">
    <div id="view-pipeline">
      <h1>Insurance &amp; Investment Pipeline</h1>
      <p class="sub">Leads from Nikki directly, plus cross-referrals from Neo when a mortgage client has no insurance or no retirement plan.</p>

      <div class="stats" id="stats"></div>

      <div class="toolbar">
        <input id="search" placeholder="Search by name, phone, email...">
        <button class="btn secondary" id="archiveViewToggle" onclick="toggleArchivedView()">📁 View archived</button>
        <select id="filterCategory"><option value="">All categories</option><option>Insurance</option><option>Investment</option><option>Both</option></select>
        <select id="filterInsurance"><option value="">Insurance: any</option></select>
        <select id="filterRetirement"><option value="">Retirement: any</option></select>
        <select id="filterAgeBand"><option value="">Age band: any</option></select>
        <button class="btn" id="addBtn">+ Add lead</button>
      </div>

      <table>
        <thead>
          <tr>
            <th>Client</th>
            <th>Deal</th>
            <th>Category</th>
            <th>Source</th>
            <th>Insurance</th>
            <th>Retirement</th>
            <th>Stage</th>
            <th>Call</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
      <div class="row-cards" id="rowCards"></div>
      <div class="empty" id="emptyState" style="display:none;">
        <div class="big">No leads yet</div>
        <div>Tap "+ Add lead" to start building your pipeline.</div>
      </div>
    </div>

    <div class="overlay" id="overlay">
      <div class="panel" id="panel"></div>
    </div>

    <div class="overlay" id="callOverlay">
      <div class="panel" id="callPanel" style="max-width:420px;"></div>
    </div>

    <div class="overlay" id="satOverlay">
      <div class="panel" id="satPanel" style="max-width:480px;"></div>
    </div>

    <div class="overlay" id="addProspectOverlay">
      <div class="panel" id="addProspectPanel" style="max-width:420px;">
        <h2>Add prospect</h2>
        <div class="rgrid" style="margin-top:14px;">
          <div class="rfield"><label>First name</label><input id="newProspectFirst" autocomplete="off"></div>
          <div class="rfield"><label>Last name</label><input id="newProspectLast" autocomplete="off"></div>
          <div class="rfield"><label>City</label><input id="newProspectCity" autocomplete="off"></div>
          <div class="rfield"><label>Phone</label><input id="newProspectPhone" autocomplete="off"></div>
          <div class="rfield" style="grid-column:1/-1;"><label>Email</label><input id="newProspectEmail" autocomplete="off"></div>
          <div class="rfield" style="grid-column:1/-1;"><label>List</label>
            <select id="newProspectTier"><option>Top 25</option><option>Top 50</option><option>Top 100</option></select>
          </div>
        </div>
        <div class="panel-actions">
          <button class="btn ghost" id="cancelAddProspect">Cancel</button>
          <button class="btn" id="confirmAddProspect">Add prospect</button>
        </div>
      </div>
    </div>

    <div class="overlay" id="addChildOverlay">
      <div class="panel" id="addChildPanel" style="max-width:400px;">
        <h2>Add child</h2>
        <div class="rgrid" style="margin-top:14px;">
          <div class="rfield" style="grid-column:1/-1;"><label>Name</label><input id="newChildName" autocomplete="off"></div>
          <div class="rfield"><label>Age</label><input id="newChildAge" type="number" min="0"></div>
          <div class="rfield"><label>Date of birth</label><input id="newChildDob" type="date"></div>
        </div>
        <div class="panel-actions">
          <button class="btn ghost" id="cancelAddChild">Cancel</button>
          <button class="btn" id="confirmAddChild">Add child</button>
        </div>
      </div>
    </div>

    <div class="drawer-overlay" id="recruitFilterOverlay">
      <div class="drawer" id="recruitFilterDrawer">
        <h2>More filters</h2>
        <div class="rfield"><label>Profession</label><input id="filterProfession" placeholder="e.g. teacher, nurse..."></div>
        <div class="rfield"><label>Age band</label>
          <select id="filterAgeBandRecruit">
            <option value="">Any age</option>
            <option value="25-30">25–30</option>
            <option value="30-35">30–35</option>
            <option value="36-40">36–40</option>
            <option value="41-45">41–45</option>
            <option value="46-50">46–50</option>
            <option value="51-55">51–55</option>
            <option value="56-60">56–60</option>
            <option value="61-65">61–65</option>
            <option value="65-999">65+</option>
          </select>
        </div>
        <div class="rfield"><label>Hobbies</label><input id="filterHobbies" placeholder="e.g. cricket, golf..."></div>
        <div class="rfield"><label>Marital status</label>
          <select id="filterMaritalStatus"><option value="">Any</option><option value="married">Married / partnered</option><option value="single">Single</option></select>
        </div>
        <div class="rfield"><label>Kids</label>
          <select id="filterHasKids"><option value="">Any</option><option value="yes">Has kids</option><option value="no">No kids</option></select>
        </div>
        <div class="panel-actions">
          <button class="btn ghost small" id="clearRecruitFiltersBtn" type="button">Clear</button>
          <button class="btn small" id="closeRecruitFiltersBtn" type="button">Done</button>
        </div>
      </div>
    </div>

    <div id="view-recruits" style="display:none;">
      <h1>Recruits — Guru's Training Dashboard</h1>
      <p class="sub">Licensing progress, Super Saturday attendance, qualifying events, and coaching signals for every recruit. Guru owns training and attendance; Sasha owns the rest of the tracking.</p>

      <div class="stats" id="recruitStats"></div>

      <div class="toolbar">
        <input id="recruitSearch" placeholder="Search recruits by name...">
        <select id="filterCoachability"><option value="">Coaching level: any</option><option>Level 1 — On track</option><option>Level 2 — Average/below average</option><option>Level 3 — Needs attention</option><option>Elite</option></select>
        <select id="filterRisk"><option value="">Risk: any</option><option>At risk</option><option>On track</option></select>
        <button class="btn ghost small" id="openRecruitFiltersBtn" type="button">🔍 More filters<span id="recruitFilterBadge" style="display:none;"></span></button>
        <label style="font-size:13px; color:var(--slate); display:flex; align-items:center; gap:6px;">My current level:
          <input id="myLevel" placeholder="e.g. SGA" style="width:110px;" onchange="saveMyLevel(this.value)">
        </label>
        <button class="btn" id="addRecruitBtn">+ Add recruit</button>
      </div>

      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Profession</th>
            <th>Program day</th>
            <th>Coaching level</th>
            <th>Attendance</th>
            <th>Licensing</th>
            <th>Risk</th>
          </tr>
        </thead>
        <tbody id="recruitTbody"></tbody>
      </table>
      <div class="row-cards" id="recruitRowCards"></div>
      <div id="recruitEmpty" style="display:none;" class="empty">No recruits match right now.</div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const ENDPOINT = 'https://fincop-backend.onrender.com/app-data/insurance-clients';
const RECRUIT_ENDPOINT = 'https://fincop-backend.onrender.com/app-data/insurance-recruits';
const STATUS_OPTIONS = ["No","Yes — Sufficient","Yes — Insufficient"];
const AGE_BANDS = ["Under 40","40-45","46-50","51-55","56-60","61-65","65+"];
const STAGE_OPTIONS = ["Lead","Contacted","FNA Sent","FNA Completed","Application","Approved","Declined","Not Interested"];
const CERT_EXAMS = ["Ethics","Accident & Sickness","Life","Segregated Funds"];
const PROV_EXAMS = ["Ethics (Provincial)","Accident & Sickness (Provincial)","Life (Provincial)","Segregated Funds (Provincial)"];
const TIER_OPTIONS = ["Level 1 — On track","Level 2 — Average/below average","Level 3 — Needs attention","Elite"];
const TRAINER_OPTIONS = ["Not yet","In progress","Eligible"];
const NAME_LIST_TIERS = ["Top 25","Top 50","Top 75","Top 100"];
const CURRICULUM_OPTIONS = ["1-1-7","3-3-30"];
const EMPLOYMENT_OPTIONS = ["Homemaker","Self-employed","Part-time employed","Full-time employed"];
const PT_FT_OPTIONS = ["Part-time","Full-time"];
const LEG_OPTIONS = ["First leg","Second leg","Third leg"];
const YES_NO_OPTIONS = ["Yes","No"];
const PARTNER_RELATION_OPTIONS = ["Spouse","Partner","Other family member"];
const PROSPECT_TIERS = ["Top 25","Top 50","Top 100"];

let clients = [];
let recruits = [];
let openRecruitId = null;
let viewArchived = false;

function saturdaysInYear(year){
  let count = 0;
  const d = new Date(year,0,1);
  while(d.getFullYear()===year){
    if(d.getDay()===6) count++;
    d.setDate(d.getDate()+1);
  }
  return count;
}

function attendancePct(r){
  const year = new Date().getFullYear();
  const total = saturdaysInYear(year);
  const attended = (r.superSaturdays||[]).filter(s=> typeof s==='string' && s.startsWith(year+'-')).length;
  if(total===0) return 0;
  return Math.round((attended/total)*100);
}

function isAtRisk(r){
  const pct = attendancePct(r);
  if(pct < 60) return true;
  if(r.coachingLevel === 'Level 3 — Needs attention') return true;
  if(r.studyLevel === 'Level 3 — Needs attention') return true;
  if(r.learningLevel === 'Level 3 — Needs attention') return true;
  return false;
}

