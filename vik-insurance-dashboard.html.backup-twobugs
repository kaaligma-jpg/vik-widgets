  const ret = document.getElementById('filterRetirement').value;
  const band = document.getElementById('filterAgeBand').value;
  if(q){
    const hay = `${c.name||''} ${c.phone||''} ${c.email||''}`.toLowerCase();
    if(hay.indexOf(q)===-1) return false;
  }
  if(cat && c.leadCategory !== cat) return false;
  if(ins && (c.insuranceStatus||'') !== ins) return false;
  if(ret && (c.retirementStatus||'') !== ret) return false;
  if(band && (c.ageBand || ageBandFor(c.age)) !== band) return false;
  return true;
}

