<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nikki — Insurance Site Greeter Prototype</title>
<style>
  :root {
    --navy: #16233F;
    --navy-deep: #0E1830;
    --gold: #B98A3E;
    --gold-light: #D9B677;
    --cream: #F7F4EE;
    --paper: #FFFFFF;
    --ink: #1E2430;
    --ink-soft: #5B6270;
    --line: #E4E0D6;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: 'Georgia', 'Iowan Old Style', serif;
    background: var(--cream);
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 40px 20px;
  }

  .site-mock {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background:
      linear-gradient(180deg, var(--navy-deep) 0%, var(--navy) 45%, var(--cream) 45%);
    z-index: 0;
  }

  .site-mock-header {
    position: absolute;
    top: 36px; left: 48px;
    color: var(--gold-light);
    font-size: 22px;
    letter-spacing: 0.3px;
  }

  .site-mock-sub {
    position: absolute;
    top: 78px; left: 48px;
    color: #C9CEDA;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
    max-width: 420px;
    line-height: 1.6;
  }

  .widget-anchor {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
  }

  .launcher {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: var(--navy);
    border: 2px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(14, 24, 48, 0.35);
    transition: transform 0.15s ease;
  }
  .launcher:hover { transform: scale(1.05); }
  .launcher svg { width: 30px; height: 30px; }

  .panel {
    width: 380px;
    max-width: calc(100vw - 40px);
    height: 560px;
    max-height: calc(100vh - 120px);
    background: var(--paper);
    border-radius: 18px;
    box-shadow: 0 20px 60px rgba(14, 24, 48, 0.28);
    display: none;
    flex-direction: column;
    overflow: hidden;
    font-family: 'Helvetica Neue', Arial, sans-serif;
  }
  .panel.open { display: flex; }

  .panel-head {
    background: var(--navy);
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--cream);
  }
  .panel-head .avatar {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--gold);
    display: flex; align-items: center; justify-content: center;
    color: var(--navy-deep);
    font-family: Georgia, serif;
    font-weight: bold;
    font-size: 17px;
  }
  .panel-head .who .name {
    font-family: Georgia, serif;
    font-size: 16px;
  }
  .panel-head .who .status {
    font-size: 11.5px;
    color: var(--gold-light);
    margin-top: 2px;
  }
  .panel-head .close {
    margin-left: auto;
    cursor: pointer;
    color: #C9CEDA;
    font-size: 20px;
    line-height: 1;
    padding: 4px;
  }
  .panel-head .close:hover { color: white; }

  .thread {
    flex: 1;
    padding: 18px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--cream);
  }

  .bubble {
    max-width: 82%;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 14px;
    line-height: 1.45;
  }
  .bubble.neo {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    border-bottom-left-radius: 4px;
    align-self: flex-start;
  }
  .bubble.user {
    background: var(--navy);
    color: var(--cream);
    border-bottom-right-radius: 4px;
    align-self: flex-end;
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
  .choice {
    padding: 8px 14px;
    border-radius: 20px;
    border: 1.5px solid var(--navy);
    background: var(--paper);
    color: var(--navy);
    font-size: 13px;
    cursor: pointer;
    transition: all 0.12s ease;
  }
  .choice:hover {
    background: var(--navy);
    color: var(--cream);
  }

  .input-row {
    border-top: 1px solid var(--line);
    padding: 12px 14px;
    display: flex;
    gap: 8px;
    background: var(--paper);
  }
  .input-row input {
    flex: 1;
    border: 1.5px solid var(--line);
    border-radius: 22px;
    padding: 10px 16px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
  }
  .input-row input:focus { border-color: var(--gold); }
  .input-row button {
    border: none;
    background: var(--gold);
    color: var(--navy-deep);
    width: 40px; height: 40px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 16px;
    flex-shrink: 0;
  }
  .input-row button:hover { background: var(--gold-light); }
  .input-row.hidden { display: none; }

  .lead-card {
    align-self: stretch;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
    font-size: 13px;
    color: var(--ink-soft);
  }
  .lead-card .title {
    font-family: Georgia, serif;
    color: var(--ink);
    font-size: 14px;
    margin-bottom: 8px;
  }
  .lead-card .row { display: flex; justify-content: space-between; padding: 3px 0; gap: 10px; }
  .lead-card .row span:first-child { color: var(--ink-soft); flex-shrink: 0; }
  .lead-card .row span:last-child { color: var(--ink); font-weight: 600; text-align: right; }
  .lead-card .flag {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
    color: var(--gold);
    font-size: 12px;
  }

  .typing {
    align-self: flex-start;
    display: flex;
    gap: 4px;
    padding: 10px 14px;
  }
  .typing span {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--ink-soft);
    opacity: 0.4;
    animation: bounce 1.2s infinite;
  }
  .typing span:nth-child(2) { animation-delay: 0.15s; }
  .typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  .caption {
    position: fixed;
    bottom: 28px;
    left: 28px;
    max-width: 320px;
    color: var(--gold-light);
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 12.5px;
    line-height: 1.6;
    z-index: 10;
  }
  .caption b { color: var(--cream); }

  /* Self-serve form */
  .self-form {
    align-self: stretch;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .self-form .title {
    font-family: Georgia, serif;
    color: var(--ink);
    font-size: 14px;
    margin-bottom: 4px;
  }
  .self-form label {
    font-size: 12px;
    color: var(--ink-soft);
    margin-bottom: -6px;
  }
  .self-form input, .self-form select {
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: 9px 12px;
    font-size: 13.5px;
    font-family: inherit;
    outline: none;
  }
  .self-form input:focus, .self-form select:focus { border-color: var(--gold); }
  .self-form .submit-btn {
    margin-top: 6px;
    border: none;
    background: var(--navy);
    color: var(--cream);
    padding: 10px 14px;
    border-radius: 22px;
    font-size: 13.5px;
    cursor: pointer;
  }
  .self-form .submit-btn:hover { background: var(--navy-deep); }
</style>
</head>
<body>

<div class="site-mock">
  <div class="site-mock-header">Vik Insurance &amp; Wealth</div>
  <div class="site-mock-sub">This dark strip stands in for your insurance website's homepage. Nikki lives in the corner, ready the moment someone lands here.</div>
</div>

<div class="caption">
  Click the gold circle to start.
</div>

<div class="widget-anchor">
  <div class="panel" id="panel">
    <div class="panel-head">
      <div class="avatar">N</div>
      <div class="who">
        <div class="name">Nikki</div>
        <div class="status">Usually replies in a few seconds</div>
      </div>
      <div class="close" id="closeBtn">&times;</div>
    </div>
    <div class="thread" id="thread"></div>
    <div class="input-row hidden" id="inputRow">
      <input type="text" id="textInput" placeholder="Type here...">
      <button id="sendBtn">&#10148;</button>
    </div>
  </div>

  <div class="launcher" id="launcher">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5C4.45 20 4 19.55 4 19V12Z" stroke="#D9B677" stroke-width="1.6"/>
      <circle cx="9" cy="12" r="1.2" fill="#D9B677"/>
      <circle cx="12" cy="12" r="1.2" fill="#D9B677"/>
      <circle cx="15" cy="12" r="1.2" fill="#D9B677"/>
    </svg>
  </div>
</div>

<script>
const thread = document.getElementById('thread');
const panel = document.getElementById('panel');
const launcher = document.getElementById('launcher');
const closeBtn = document.getElementById('closeBtn');
const inputRow = document.getElementById('inputRow');
const textInput = document.getElementById('textInput');
const sendBtn = document.getElementById('sendBtn');

let state = 'greeting';
let lead = {
  language: 'English', firstName: '', lastName: '', service: '',
  phone: '', email: '', newsletter: '',
  livingBenefits: undefined, legacy: undefined, guarantees: undefined, wealth: undefined, estate: undefined,
  hasMortgage: '', mortgageRenewalMonth: '', mortgageRenewalYear: ''
};
let started = false;
let pendingField = null; // used for spelling-confirmation loop

// Ten varied, soothing time-of-day greeting openers — one is picked at random
// each visit, and the correct time-of-day phrase is spliced in automatically.
const GREETING_TEMPLATES = [
  "{tod}, welcome! I'm Nikki. So glad you stopped by today.",
  "{tod} and welcome — I'm Nikki. Thanks so much for taking a moment to visit.",
  "{tod}, I'm Nikki. It's genuinely nice to have you here.",
  "{tod}! I'm Nikki, and I'll take good care of you from here.",
  "{tod} — I'm Nikki. Thank you for choosing to spend a little time with us.",
  "{tod}! I'm Nikki. I hope your day is off to a good start.",
  "{tod}, welcome aboard — I'm Nikki, here to help however I can.",
  "{tod}, I'm Nikki. It's a pleasure to meet you.",
  "{tod}! I'm Nikki. Thanks for stopping in — let's make this easy for you.",
  "{tod}, and hello — I'm Nikki. Happy to walk you through things at your pace."
];

// Returns "Good morning" / "Good afternoon" / "Good evening" / "Good night"
// based on the visitor's local clock time.
function timeOfDayGreeting() {
  const hour = new Date().getHours();
  if (hour >= 5 && hour < 12) return 'Good morning';
  if (hour >= 12 && hour < 17) return 'Good afternoon';
  if (hour >= 17 && hour < 21) return 'Good evening';
  return 'Good night';
}

// Same buckets, used for the sign-off phrasing ("nice day" / "nice evening").
function timeOfDaySignoff() {
  const hour = new Date().getHours();
  if (hour >= 5 && hour < 17) return 'Have a nice day';
  return 'Have a nice evening';
}

function pickGreeting() {
  const template = GREETING_TEMPLATES[Math.floor(Math.random() * GREETING_TEMPLATES.length)];
  return template.replace('{tod}', timeOfDayGreeting());
}

/* ---------- Canadian statutory holiday / long-weekend detection ---------- */

// Major Canadian national statutory holidays (fixed + a few common
// nation-wide observed ones). Dates are recomputed per year as needed.
function canadianStatutoryHolidays(year) {
  const dates = [];
  const add = (m, d) => dates.push(new Date(year, m - 1, d).toDateString());

  // New Year's Day
  add(1, 1);
  // Canada Day
  add(7, 1);
  // Christmas & Boxing Day
  add(12, 25);
  add(12, 26);

  // Good Friday (nation-wide statutory holiday) — computed via the
  // Anonymous Gregorian algorithm for Easter Sunday, minus 2 days.
  const a = year % 19, b = Math.floor(year / 100), c = year % 100;
  const d2 = Math.floor(b / 4), e = b % 4, f = Math.floor((b + 8) / 25);
  const g = Math.floor((b - f + 1) / 3);
  const h = (19 * a + b - d2 - g + 15) % 30;
  const i = Math.floor(c / 4), k = c % 4;
  const l = (32 + 2 * e + 2 * i - h - k) % 7;
  const m2 = Math.floor((a + 11 * h + 22 * l) / 451);
  const month = Math.floor((h + l - 7 * m2 + 114) / 31);
  const day = ((h + l - 7 * m2 + 114) % 31) + 1;
  const easterSunday = new Date(year, month - 1, day);
  const goodFriday = new Date(easterSunday);
  goodFriday.setDate(easterSunday.getDate() - 2);
  dates.push(goodFriday.toDateString());

  // Victoria Day: Monday on/before May 24
  for (let d = 24; d >= 18; d--) {
    const dt = new Date(year, 4, d);
    if (dt.getDay() === 1) { dates.push(dt.toDateString()); break; }
  }
  // Labour Day: first Monday in September
  for (let d = 1; d <= 7; d++) {
    const dt = new Date(year, 8, d);
    if (dt.getDay() === 1) { dates.push(dt.toDateString()); break; }
  }
  // Thanksgiving: second Monday in October
  { let count = 0;
    for (let d = 1; d <= 31; d++) {
      const dt = new Date(year, 9, d);
      if (dt.getDay() === 1) { count++; if (count === 2) { dates.push(dt.toDateString()); break; } }
    }
  }
  // National Day for Truth and Reconciliation
  add(9, 30);
  // Remembrance Day
  add(11, 11);

  return dates;
}

function isCanadianHoliday(date) {
  const list = canadianStatutoryHolidays(date.getFullYear());
  return list.includes(date.toDateString());
}

// True if today is Thursday and tomorrow (Friday) is a holiday, OR today is
// Friday and the upcoming Monday is a holiday — either direction makes for
// a long weekend.
function isLongWeekend() {
  const today = new Date();
  const dow = today.getDay(); // 0=Sun ... 4=Thu, 5=Fri
  if (dow === 4) {
    const tomorrow = new Date(today);
    tomorrow.setDate(today.getDate() + 1);
    return isCanadianHoliday(tomorrow);
  }
  if (dow === 5) {
    const monday = new Date(today);
    monday.setDate(today.getDate() + 3);
    return isCanadianHoliday(monday);
  }
  return false;
}

function signOffMessage() {
  return isLongWeekend() ? 'Have a great long weekend!' : (timeOfDaySignoff() + '!');
}

function scrollDown() {
  thread.scrollTop = thread.scrollHeight;
}

function addBubble(text, who) {
  const b = document.createElement('div');
  b.className = 'bubble ' + who;
  b.textContent = text;
  thread.appendChild(b);
  scrollDown();
  return b;
}

function addChoices(options, onPick) {
  const wrap = document.createElement('div');
  wrap.className = 'choices';
  options.forEach(opt => {
    const c = document.createElement('div');
    c.className = 'choice';
    c.textContent = opt;
    c.onclick = () => {
      wrap.remove();
      addBubble(opt, 'user');
      onPick(opt);
    };
    wrap.appendChild(c);
  });
  thread.appendChild(wrap);
  scrollDown();
  return wrap;
}

function showTyping(callback, delay = 700) {
  const t = document.createElement('div');
  t.className = 'typing';
  t.innerHTML = '<span></span><span></span><span></span>';
  thread.appendChild(t);
  scrollDown();
  setTimeout(() => {
    t.remove();
    callback();
  }, delay);
}

function setInputMode(on, placeholder) {
  if (on) {
    inputRow.classList.remove('hidden');
    textInput.placeholder = placeholder || 'Type here...';
    textInput.value = '';
    textInput.focus();
  } else {
    inputRow.classList.add('hidden');
  }
}

/* ---------- Entry point: type-yourself vs talk-to-Nikki ---------- */

function beginFlow() {
  setInputMode(false);
  showTyping(() => {
    // Greeting and language question merged into the very first message.
    addBubble(pickGreeting() + " Before we get started, besides English, is there another language you'd feel more comfortable speaking in? I can chat in just about any language there is.", 'neo');
    addChoices(['English is fine', 'हिंदी', 'ਪੰਜਾਬੀ', 'Español', '中文', 'Another language...'], (choice) => {
      if (choice === 'Another language...') {
        setInputMode(true, 'e.g. Tagalog, Farsi, Portuguese...');
        state = 'language';
        return;
      }
      lead.language = (choice === 'English is fine') ? 'English' : choice;
      confirmAndContinue(languageConfirmedMessage(), askModeChoice);
    });
  }, 500);
}

// Note: this demo runs in English text only. In the live version, every
// message below would be delivered in lead.language once chosen.
function languageConfirmedMessage() {
  if (lead.language === 'English') {
    return "Great, we'll continue in English.";
  }
  return `Wonderful, we'll go with ${lead.language} from here. (Note: this demo displays English text throughout, but the live version would carry the full conversation in ${lead.language}.)`;
}

function askModeChoice() {
  showTyping(() => {
    addBubble("Would you like to fill in your details yourself, or shall I ask you a few quick questions and take care of it for you?", 'neo');
    addChoices(["I'll type it myself", "Ask me questions"], (choice) => {
      if (choice === "I'll type it myself") {
        showSelfForm();
      } else {
        askFirstName();
      }
    });
  }, 500);
}

/* ---------- Self-serve form path ---------- */

function showSelfForm() {
  showTyping(() => {
    addBubble("Of course — no problem at all. Just fill in what you can below and submit whenever you're ready.", 'neo');

    const form = document.createElement('div');
    form.className = 'self-form';
    form.innerHTML = `
      <div class="title">Quick inquiry form</div>
      <label>First name</label>
      <input type="text" id="f_first" placeholder="e.g. Priya">
      <label>Last name</label>
      <input type="text" id="f_last" placeholder="e.g. Sharma">
      <label>Phone number</label>
      <input type="text" id="f_phone" placeholder="e.g. 416 555 0123">
      <label>Email</label>
      <input type="text" id="f_email" placeholder="e.g. priya@email.com">
      <label>What brings you here?</label>
      <select id="f_service">
        <option value="">Select one...</option>
        <option>Life Insurance</option>
        <option>Living Benefits</option>
        <option>Retirement Planning</option>
        <option>General Inquiry</option>
      </select>
      <label>If you got sick or hurt tomorrow, is your income protected?</label>
      <select id="f_livingBenefits">
        <option value="">Select one...</option>
        <option>Yes</option>
        <option>No</option>
      </select>
      <label>If you weren't here tomorrow, would your family's life stay the same?</label>
      <select id="f_legacy">
        <option value="">Select one...</option>
        <option>Yes</option>
        <option>No</option>
      </select>
      <label>Is your retirement principal protected in a market crash?</label>
      <select id="f_guarantees">
        <option value="">Select one...</option>
        <option>Yes</option>
        <option>No</option>
      </select>
      <label>Do you have a structure in place to stay wealthy, not just build it?</label>
      <select id="f_wealth">
        <option value="">Select one...</option>
        <option>Yes</option>
        <option>No</option>
      </select>
      <label>Is your estate set up to go exactly where you want it to?</label>
      <select id="f_estate">
        <option value="">Select one...</option>
        <option>Yes</option>
        <option>No</option>
      </select>
      <label>Would you like our monthly newsletter with useful financial tips?</label>
      <select id="f_newsletter">
        <option value="">Select one...</option>
        <option>Yes, please</option>
        <option>No, thank you</option>
      </select>
      <label>Do you currently have a mortgage?</label>
      <select id="f_hasMortgage">
        <option value="">Select one...</option>
        <option>Yes</option>
        <option>No</option>
      </select>
      <label>If yes — approximate renewal month/year (e.g. June 2027)</label>
      <input type="text" id="f_mortgageRenewal" placeholder="Leave blank if no mortgage">
      <div class="form-error" id="formError" style="display:none; color:#c0392b; font-size:13px; margin-top:4px;"></div>
      <div class="submit-btn" id="formSubmitBtn">Submit inquiry</div>
    `;
    thread.appendChild(form);
    scrollDown();

    const requiredFields = [
      { id: 'f_first', label: 'First name' },
      { id: 'f_last', label: 'Last name' },
      { id: 'f_phone', label: 'Phone number' },
      { id: 'f_email', label: 'Email' },
      { id: 'f_service', label: 'What brings you here' },
      { id: 'f_livingBenefits', label: 'Income protection question' },
      { id: 'f_legacy', label: 'Legacy question' },
      { id: 'f_guarantees', label: 'Retirement guarantees question' },
      { id: 'f_wealth', label: 'Staying wealthy question' },
      { id: 'f_estate', label: 'Estate planning question' },
      { id: 'f_newsletter', label: 'Newsletter question' },
      { id: 'f_hasMortgage', label: 'Mortgage question' }
    ];

    document.getElementById('formSubmitBtn').onclick = () => {
      const errorBox = document.getElementById('formError');
      const missing = requiredFields.filter(f => !document.getElementById(f.id).value.trim());
      const hasMortgageVal = document.getElementById('f_hasMortgage').value;
      const renewalVal = document.getElementById('f_mortgageRenewal').value.trim();
      if (hasMortgageVal === 'Yes' && !renewalVal) {
        missing.push({ id: 'f_mortgageRenewal', label: 'Approximate renewal month/year' });
      }
      if (missing.length > 0) {
        errorBox.textContent = `Please fill in: ${missing.map(f => f.label).join(', ')} before submitting.`;
        errorBox.style.display = 'block';
        missing.forEach(f => { document.getElementById(f.id).style.borderColor = '#c0392b'; });
        return;
      }
      errorBox.style.display = 'none';

      lead.firstName = document.getElementById('f_first').value.trim();
      lead.lastName = document.getElementById('f_last').value.trim();
      lead.phone = document.getElementById('f_phone').value.trim();
      lead.email = document.getElementById('f_email').value.trim();
      lead.service = document.getElementById('f_service').value;
      lead.livingBenefits = document.getElementById('f_livingBenefits').value;
      lead.legacy = document.getElementById('f_legacy').value;
      lead.guarantees = document.getElementById('f_guarantees').value;
      lead.wealth = document.getElementById('f_wealth').value;
      lead.estate = document.getElementById('f_estate').value;
      lead.newsletter = document.getElementById('f_newsletter').value;
      lead.hasMortgage = hasMortgageVal;
      lead.mortgageRenewalMonth = renewalVal;
      form.remove();
      addBubble('Submitted my details', 'user');
      finishFlow();
    };
  }, 500);
}

/* ---------- Talk-to-Nikki path ---------- */

function confirmAndContinue(message, next) {
  showTyping(() => {
    addBubble(message, 'neo');
    next();
  }, 500);
}

/* Spelling-confirmation helper: shows what Nikki captured, asks the person
   to confirm or correct it, since Nikki is typing it into English fields
   while speaking in whatever language was chosen. */
function askSpellingConfirm(fieldLabel, value, onConfirmed) {
  showTyping(() => {
    addBubble(`Just to make sure I've got it right — I'm noting "${value}" for your ${fieldLabel}. Is that spelled correctly?`, 'neo');
    addChoices(['Yes, correct', "No, let me fix it"], (choice) => {
      if (choice === 'Yes, correct') {
        showTyping(() => { addBubble('Perfect, thank you.', 'neo'); onConfirmed(value); }, 400);
      } else {
        setInputMode(true, 'Type the correct spelling...');
        pendingField = { label: fieldLabel, onConfirmed };
        state = 'correcting';
      }
    });
  });
}

function askFirstName() {
  showTyping(() => {
    addBubble("Lovely. What's your first name?", 'neo');
    setInputMode(true, 'e.g. Priya');
    state = 'firstName';
  });
}

function askLastName() {
  showTyping(() => {
    addBubble("And your last name?", 'neo');
    setInputMode(true, 'e.g. Sharma');
    state = 'lastName';
  });
}

function askPhone() {
  showTyping(() => {
    addBubble(`Thank you, ${lead.firstName}. What's the best phone number to reach you on?`, 'neo');
    setInputMode(true, 'e.g. 416 555 0123');
    state = 'phone';
  });
}

function askEmail() {
  showTyping(() => {
    addBubble("And an email address, in case we need to send you anything?", 'neo');
    setInputMode(true, 'e.g. priya@email.com');
    state = 'email';
  });
}

function askService() {
  setInputMode(false);
  showTyping(() => {
    addBubble("What brings you here today?", 'neo');
    addChoices(['Life Insurance', 'Living Benefits', 'Retirement Planning', 'General Inquiry'], (choice) => {
      lead.service = choice;
      askTopicMenu();
    });
  });
}

/* ---------- Five topic questions: living benefits, death & legacy,
   retirement/guarantees, wealth-building, estate planning ---------- */

const TOPICS = [
  {
    key: 'livingBenefits',
    label: 'Living Benefits',
    question: "Here's a real one — if you got sick or hurt tomorrow and couldn't work, is your income protected?"
  },
  {
    key: 'legacy',
    label: 'Death and Legacy',
    question: "Let me ask you something most people avoid — if you weren't here tomorrow, would your family's life stay exactly the same?"
  },
  {
    key: 'guarantees',
    label: 'Retirement Guarantees',
    question: "Quick one on your money — if the market crashed tomorrow, is your principal actually protected?"
  },
  {
    key: 'wealth',
    label: 'Staying Wealthy',
    question: "Here's something worth thinking about — the wealthy don't just get wealthy, they stay wealthy. Do you have a structure in place that protects what you build?"
  },
  {
    key: 'estate',
    label: 'Estate Planning',
    question: "Last one, and it's an important one — when everything you've built passes on, is it going exactly where you want it to?"
  }
];

function askTopicMenu() {
  showTyping(() => {
    addBubble("I've got five real questions for you — the kind most people don't stop to think about until it's too late. Living benefits, death and legacy, retirement guarantees, staying wealthy, and estate planning.", 'neo');
    showTyping(() => {
      addBubble("Which one should we start with?", 'neo');
      addChoices(TOPICS.map(t => t.label), (choiceLabel) => {
        const topic = TOPICS.find(t => t.label === choiceLabel);
        askTopic(topic, 0);
      });
    }, 600);
  });
}

function askTopic(topic, index) {
  showTyping(() => {
    addBubble(topic.question, 'neo');
    addChoices(['Yes', 'No'], (choice) => {
      lead[topic.key] = choice;
      showTyping(() => {
        addBubble("Want to know more about this one, or should we move on?", 'neo');
        addChoices(['Tell me more', "Let's move on"], (moreChoice) => {
          if (moreChoice === 'Tell me more') {
            showTyping(() => {
              addBubble("Great question — Vik will walk you through the full picture on this personally when you connect.", 'neo');
              proceedToNextTopic(topic, index);
            }, 500);
          } else {
            proceedToNextTopic(topic, index);
          }
        });
      }, 500);
    });
  });
}

function proceedToNextTopic(currentTopic, index) {
  const remaining = TOPICS.filter(t => t.key !== currentTopic.key && lead[t.key] === undefined);
  if (remaining.length === 0) {
    askNewsletter();
    return;
  }
  showTyping(() => {
    addBubble("Want to go through the rest, or are we good for now?", 'neo');
    addChoices(["Continue", "That's enough for now"], (choice) => {
      if (choice === "That's enough for now") {
        askNewsletter();
      } else {
        addChoices(remaining.map(t => t.label), (choiceLabel) => {
          const nextTopic = remaining.find(t => t.label === choiceLabel);
          askTopic(nextTopic, index + 1);
        });
      }
    });
  }, 500);
}

function askNewsletter() {
  showTyping(() => {
    addBubble("Last thing — would you like to receive our monthly newsletter? It's full of useful financial tips.", 'neo');
    addChoices(['Yes, please', 'No, thank you'], (choice) => {
      lead.newsletter = choice;
      askMortgage();
    });
  });
}

function askMortgage() {
  showTyping(() => {
    addBubble("One more quick one — do you currently have a mortgage?", 'neo');
    addChoices(['Yes', 'No'], (choice) => {
      lead.hasMortgage = choice;
      if (choice === 'Yes') {
        askMortgageRenewal();
      } else {
        finishFlow();
      }
    });
  });
}

function askMortgageRenewal() {
  showTyping(() => {
    addBubble("Got it — and roughly what month and year is your mortgage up for renewal? Just an estimate is fine.", 'neo');
    setInputMode(true, 'e.g. June 2027');
    state = 'mortgageRenewal';
  });
}

function finishFlow() {
  setInputMode(false);
  showTyping(() => {
    addBubble(`Perfect, ${lead.firstName || ''}. Vik will have your details and someone will reach out shortly. And don't forget — our team can also help with mortgages and borrowing needs whenever that comes up! ${signOffMessage()}`, 'neo');
    showLeadCard();
    pushLeadToDashboard();
  }, 800);
}

// ---- Dashboard sync: sends this lead into Nikki's own insurance pipeline
// store (separate from the mortgage dashboard's data), so insurance and
// mortgage leads never mix. Mirrors the client object shape used by
// vik-insurance-dashboard.html (id, createdAt, dealCode, notesList, ...).
async function pushLeadToDashboard() {
  const endpoint = 'https://fincop-backend.onrender.com/app-data/insurance-clients';
  try {
    const res = await fetch(endpoint);
    const data = await res.json();
    const clients = data && data.value ? JSON.parse(data.value) : [];

    const dealCode = 'vinc 1' + String(clients.length + 1).padStart(4, '0');
    const fullName = `${lead.firstName || ''} ${lead.lastName || ''}`.trim();

    // Nikki's site covers both insurance and investment/retirement
    // conversations; "service" (what brought them in) decides which
    // category the lead lands under, defaulting to "Both" when unclear.
    const svc = (lead.service || '').toLowerCase();
    let leadCategory = 'Both';
    if (svc.indexOf('retire') !== -1 || svc.indexOf('invest') !== -1) leadCategory = 'Investment';
    else if (svc.indexOf('insur') !== -1 || svc.indexOf('living') !== -1 || svc.indexOf('legacy') !== -1) leadCategory = 'Insurance';

    clients.push({
      id: 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8),
      createdAt: Date.now(),
      dealCode,
      notesList: [],
      name: fullName,
      phone: lead.phone || '',
      email: lead.email || '',
      age: null,
      ageBand: '',
      leadCategory,
      stage: 'Lead',
      insuranceStatus: '',
      retirementStatus: '',
      sourceAgent: 'Nikki',
      sourceNotes: `Language: ${lead.language || '—'}; Living Benefits: ${lead.livingBenefits || '—'}; Death and Legacy: ${lead.legacy || '—'}; Retirement Guarantees: ${lead.guarantees || '—'}; Staying Wealthy: ${lead.wealth || '—'}; Estate Planning: ${lead.estate || '—'}; Newsletter: ${lead.newsletter || '—'}`,
      linkedMortgageDealCode: ''
    });

    await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ value: JSON.stringify(clients) })
    });

    // Cross-referral: spawn a lead in Neo's mortgage pipeline either way —
    // "Yes" (has a mortgage) is a renewal opportunity, "No" (no mortgage yet)
    // is a brand-new mortgage client opportunity down the line.
    if (lead.hasMortgage === 'Yes' || lead.hasMortgage === 'No') {
      pushMortgageCrossReferral(dealCode, fullName, lead.hasMortgage);
    }
  } catch (e) {
    console.error('Nikki: could not push lead to dashboard', e);
  }
}

// Creates a new lead in the mortgage pipeline (same store Neo's widget and
// vik-mortgage-dashboard.html read from) when an insurance client mentions
// they already have a mortgage — tagged back to the originating insurance
// deal via linkedInsuranceDealCode, with the renewal timing noted for
// Neo's 365-day-out follow-up countdown.
async function pushMortgageCrossReferral(insuranceDealCode, fullName, hasMortgage) {
  const endpoint = 'https://fincop-backend.onrender.com/app-data/mortgage-clients';
  const isRenewal = hasMortgage === 'Yes';
  const opportunityLabel = isRenewal ? 'Renewal opportunity' : 'New mortgage client opportunity';
  const opportunityDetail = isRenewal
    ? `Renewal opportunity — client already has a mortgage elsewhere. Approximate renewal: ${lead.mortgageRenewalMonth || 'not given'}.`
    : 'New mortgage client opportunity — client currently has no mortgage, a future first-time/purchase prospect.';
  try {
    const res = await fetch(endpoint);
    const data = await res.json();
    const mortClients = data && data.value ? JSON.parse(data.value) : [];

    const dealCode = 'vmtg 1' + String(mortClients.length + 1).padStart(4, '0');
    mortClients.push({
      id: 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8),
      createdAt: Date.now(),
      dealCode,
      notesList: [{ text: opportunityDetail, ts: Date.now(), author: 'Nikki' }],
      topSummary: opportunityLabel,
      name: fullName,
      phone: lead.phone || '',
      email: lead.email || '',
      city: '', dob: '', age: null, anniversary: '', religion: '',
      dealCategory: '', product: '', mortgageType: '',
      stage: 'Lead',
      propertyAddress: '', propertyType: '', propertyTypeOther: '',
      multipleProperties: false,
      insuranceSoldWithDeal: false,
      calledByVik: false,
      closingDate: '',
      mortgageTerm: '',
      renewalDate: '',
      renewalMonthYearApprox: lead.mortgageRenewalMonth || '',
      insuranceStatus: '', retirementStatus: '',
      dependents: [], additionalProperties: [],
      educationPlanStatus: '',
      referralType: 'Website/Online Ad', referralOther: '',
      referralName: '', referralEmail: '', referralPhone: '',
      researchNotes: [], researchStatus: 'pending',
      sourceAgent: 'Nikki',
      sourceNotes: `Cross-referred from an insurance deal (${insuranceDealCode}) — ${opportunityDetail}`,
      linkedInsuranceDealCode: insuranceDealCode
    });

    await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ value: JSON.stringify(mortClients) })
    });
  } catch (e) {
    console.error('Nikki: could not push mortgage cross-referral', e);
  }
}

function showLeadCard() {
  const card = document.createElement('div');
  card.className = 'lead-card';
  card.innerHTML = `
    <div class="title">New lead created</div>
    <div class="row"><span>Name</span><span>${lead.firstName} ${lead.lastName}</span></div>
    <div class="row"><span>Service</span><span>${lead.service}</span></div>
    <div class="row"><span>Phone</span><span>${lead.phone}</span></div>
    <div class="row"><span>Email</span><span>${lead.email}</span></div>
    <div class="row"><span>Language</span><span>${lead.language}</span></div>
    <div class="row"><span>Living Benefits</span><span>${lead.livingBenefits || '—'}</span></div>
    <div class="row"><span>Death and Legacy</span><span>${lead.legacy || '—'}</span></div>
    <div class="row"><span>Retirement Guarantees</span><span>${lead.guarantees || '—'}</span></div>
    <div class="row"><span>Staying Wealthy</span><span>${lead.wealth || '—'}</span></div>
    <div class="row"><span>Estate Planning</span><span>${lead.estate || '—'}</span></div>
    <div class="row"><span>Newsletter</span><span>${lead.newsletter || '—'}</span></div>
    <div class="flag">&#9679; Vikram's research will run automatically on this lead</div>
  `;
  thread.appendChild(card);
  scrollDown();
}

function handleTextSubmit() {
  const val = textInput.value.trim();
  if (!val) return;
  addBubble(val, 'user');
  textInput.value = '';
  setInputMode(false);

  if (state === 'language') {
    lead.language = val;
    confirmAndContinue(languageConfirmedMessage(), askModeChoice);
  } else if (state === 'firstName') {
    askSpellingConfirm('first name', val, (confirmedVal) => {
      lead.firstName = confirmedVal;
      askLastName();
    });
  } else if (state === 'lastName') {
    askSpellingConfirm('last name', val, (confirmedVal) => {
      lead.lastName = confirmedVal;
      askPhone();
    });
  } else if (state === 'phone') {
    askSpellingConfirm('phone number', val, (confirmedVal) => {
      lead.phone = confirmedVal;
      askEmail();
    });
  } else if (state === 'email') {
    askSpellingConfirm('email address', val, (confirmedVal) => {
      lead.email = confirmedVal;
      askService();
    });
  } else if (state === 'mortgageRenewal') {
    lead.mortgageRenewalMonth = val;
    finishFlow();
  } else if (state === 'correcting') {
    // user typed the corrected value; re-run the same confirmation once more
    const field = pendingField;
    pendingField = null;
    askSpellingConfirm(field.label, val, field.onConfirmed);
  }
}

sendBtn.onclick = handleTextSubmit;
textInput.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') handleTextSubmit();
});

launcher.onclick = () => {
  panel.classList.add('open');
  launcher.style.display = 'none';
  if (!started) {
    started = true;
    beginFlow();
  }
};

closeBtn.onclick = () => {
  panel.classList.remove('open');
  launcher.style.display = 'flex';
};
</script>

</body>
</html>
